# Copy to .env and fill in. Both values are safe to expose: they ship inside the
# browser bundle by design, and the database is protected by row level security,
# not by keeping these hidden. A service_role key is a different matter entirely
# and must never appear in this file or anywhere else in the client.
#
# Without these the game runs exactly as before, offline against localStorage.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
